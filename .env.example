# Copy to .env (never commit .env). Generate secrets, e.g.:  openssl rand -base64 48
SQL_SA_PASSWORD=Change-Me-Strong-Passw0rd!
SQL_DATABASE=PharmaOS
MSSQL_PID=Express
JWT_KEY=paste-64-or-more-random-characters-here-never-reuse-the-development-key
# First provider (SaaS admin) account — used once on first start; remove afterwards and turn on MFA for it
PLATFORM_ADMIN_EMAIL=admin@yourcompany.in
PLATFORM_ADMIN_PASSWORD=Change-Me-Admin-Passw0rd!
MIGRATE_ON_STARTUP=true
AUTH_RATE_LIMIT=10
WEB_PORT=8080
