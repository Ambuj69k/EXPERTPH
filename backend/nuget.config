<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-level NuGet config: ignores machine-wide sources/fallback folders so restore is reproducible. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <config>
    <!-- C: drive is nearly full on the dev machine; keep all packages on D: -->
    <add key="globalPackagesFolder" value="D:\DevCache\nuget\packages" />
  </config>
</configuration>
